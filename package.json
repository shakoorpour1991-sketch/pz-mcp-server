{
  "name": "@minimax/pz-mcp-server",
  "version": "1.1.0",
  "description": "MCP Server for Project Zomboid mod development",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-zed-data.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dashboard": "node admin/bridge.mjs",
    "test": "npm run build && node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=80 --test-coverage-branches=70 \"tests/**/*.test.js\"",
    "benchmark": "node scripts/_benchmark.mjs",
    "lint": "eslint src/**/*.ts tests/**/*.js admin/*.mjs scripts/*.mjs",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "verify:deck": "node scripts/_verify_deck.mjs",
    "verify:kb": "node scripts/_verify_kb.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "project-zomboid",
    "modding",
    "parser",
    "sqlite"
  ],
  "author": "shakoorpour1991-sketch",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "pino": "^10.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shakoorpour1991-sketch/pz-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/shakoorpour1991-sketch/pz-mcp-server/issues"
  },
  "homepage": "https://github.com/shakoorpour1991-sketch/pz-mcp-server#readme"
}
