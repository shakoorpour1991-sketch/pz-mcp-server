{
  "name": "@minimax/pz-mcp-server",
  "version": "1.1.0",
  "description": "MCP Server for Project Zomboid mod development",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dashboard": "node admin/bridge.mjs",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "project-zomboid",
    "modding",
    "parser",
    "sqlite"
  ],
  "author": "shakoorpour1991-sketch",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^11.1.0",
    "pino": "^10.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.0",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shakoorpour1991-sketch/pz-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/shakoorpour1991-sketch/pz-mcp-server/issues"
  },
  "homepage": "https://github.com/shakoorpour1991-sketch/pz-mcp-server#readme"
}
